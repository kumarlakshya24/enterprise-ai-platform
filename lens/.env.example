# Lens runs fully offline by default. Nothing here is a secret.
# Copy to .env only if you want to point the optional judge at a provider.
# The process does not load .env automatically; export the variables yourself.

LENS_JUDGE=heuristic

# Used only when LENS_JUDGE=llm. make eval and make test never require these.
# LENS_LLM_BASE_URL=https://api.openai.com/v1
# LENS_LLM_API_KEY=
# LENS_LLM_MODEL=gpt-4o-mini

# Stratified eval sample rate. The synthetic demo uses the rate in eval/slo.yaml
# because a laptop-scale trace volume needs a higher rate to keep hourly SLIs stable.
# LENS_SAMPLE_RATE=0.05
