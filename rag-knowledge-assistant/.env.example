# Copy to .env and adjust. Never commit .env. Secrets have no defaults in code.

# --- infrastructure (docker compose overrides these for the api container)
# REQUIRED: pick any local password; docker compose refuses to start without it.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://rag:${POSTGRES_PASSWORD}@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO

# --- embeddings: onnx (local all-MiniLM-L6-v2) | openai_compat | hash (tests only)
EMBEDDING_PROVIDER=onnx
EMBEDDING_MODEL_DIR=models/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_API_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=

# --- re-ranker: onnx | none. int8 is the default (same eval score as fp32, ~40% lower latency)
RERANKER_PROVIDER=onnx
RERANKER_MODEL_DIR=models/ms-marco-MiniLM-L-6-v2-int8

# --- generator: extractive (offline, no key) | anthropic | openai_compat
LLM_PROVIDER=extractive
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# For LLM_PROVIDER=anthropic the SDK reads ANTHROPIC_API_KEY from the environment:
# ANTHROPIC_API_KEY=
# For LLM_PROVIDER=openai_compat (vLLM, Ollama, OpenAI, ...):
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=
# Cost model (USD per 1M tokens) for the cost-per-query report:
LLM_PRICE_INPUT_PER_MTOK=4.0
LLM_PRICE_OUTPUT_PER_MTOK=20.0

# --- retrieval
CANDIDATE_K=50
FINAL_K=5
FUSION_METHOD=rrf
HYBRID_VECTOR_WEIGHT=0.5
HYBRID_BM25_WEIGHT=0.5
MULTIQUERY_VARIANTS=3

# --- evidence gate (from scripts/calibrate.py on eval/calibration.yaml)
MIN_RERANK_SCORE=-7.0

# --- latency budgets (ms)
RETRIEVAL_BUDGET_MS=800
RERANK_BUDGET_MS=2500
GENERATION_BUDGET_MS=20000

# --- semantic cache
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.85
CACHE_TTL_S=21600

# --- governance
PII_MODE=external
INJECTION_MODE=strip
