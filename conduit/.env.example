# Conduit runs with none of these set. Copy to .env only if you change a default.
CONDUIT_PORT=8097
CONDUIT_EMBEDDER=fake
# CONDUIT_AEGIS_URL=http://127.0.0.1:8080
# Aegis does not expose POST /v1/redact. If this is set and the call fails, the event is quarantined.
# CONDUIT_OPENAI_API_KEY=
# CONDUIT_OPENAI_MODEL=text-embedding-3-small
# CONDUIT_OPENAI_DIM=1536
