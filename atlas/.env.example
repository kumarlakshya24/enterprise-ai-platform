# Atlas runs fully offline by default. Nothing here is a secret.
# Copy to .env if you want the HTTP adapters. Do not commit .env.

# Workflow log and the stand-in external systems (two separate SQLite files).
ATLAS_DB=./var/atlas.db
ATLAS_EFFECTS_DB=./var/effects.db

# Lease a worker holds while it drives a run. A killed process is fenced out
# until this expires. The kill-and-resume demo uses a short lease.
ATLAS_LEASE_SECONDS=30

# Tool guard. "offline" is the built-in Aegis-shaped stub.
# "aegis" POSTs to AEGIS_BASE_URL and fails closed if the gateway is unreachable.
ATLAS_GUARD=offline
AEGIS_BASE_URL=http://127.0.0.1:8080

# Knowledge tool. "offline" is the built-in Lumen-shaped stub.
# "lumen" POSTs to LUMEN_BASE_URL/ask (the Lumen API) and fails closed on error.
ATLAS_KNOWLEDGE=offline
LUMEN_BASE_URL=http://127.0.0.1:8000
LUMEN_USER_ID=atlas-worker

ATLAS_HOST=127.0.0.1
ATLAS_PORT=8096
