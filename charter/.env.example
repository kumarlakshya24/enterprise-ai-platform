# Charter runs fully offline. Nothing here is a secret.
# Copy to .env only if you want to change the demo port.
# The process does not load .env automatically; export the variables yourself.

CHARTER_PORT=8097

# Published key for the synthetic Aegis-shaped audit chain.
# This is not a credential. Regenerating fixtures with a different key
# means updating fixtures/aegis_audit.jsonl in the same commit.
# CHARTER_AUDIT_HMAC_KEY=charter-demo-not-a-secret
