# Copy to .env with `make env`: it fills every empty secret below with fresh random values.
# .env is git-ignored. Never commit it.

AEGIS_ENV=demo
AEGIS_DEMO_MODE=true

# Generated by `make env`.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
AEGIS_VAULT_KEYS=
AEGIS_VAULT_ACTIVE_KID=
AEGIS_AUDIT_HMAC_KEY=

# External LLM. Default: the bundled offline mock (no API key needed).
# To use OpenAI instead, set:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=<your key>
#   LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=http://mock-llm:8090/v1
LLM_API_KEY=
LLM_MODEL=mock-gpt

AEGIS_VAULT_TTL_SECONDS=900
AEGIS_RATE_LIMIT_PER_MINUTE=120
AEGIS_LOG_LEVEL=INFO
