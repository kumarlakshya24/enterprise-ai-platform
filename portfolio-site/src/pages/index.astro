---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Diagram from "../components/Diagram.astro";
import { githubProfile, platform, shipped, site } from "../data/projects";

const title = `${site.name} · ${site.role}`;
const description =
  "Ten offline systems for using language models safely, cheaply, and with numbers you can check. Portfolio of Lakshya Kumar.";
const stats = [
  { value: String(shipped.length), label: "systems, each runs alone" },
  { value: String(site.tests), label: "automated tests" },
  { value: "0", label: "API keys needed" },
];
---

<Base title={title} description={description}>
  <SiteHeader />

  <main id="content">
    <section class="hero" aria-labelledby="hero-title">
      <p class="eyebrow"><span class="pulse" aria-hidden="true"></span>{site.role}</p>
      <h1 id="hero-title">
        Systems that let a company use language models <em>without leaking data, overspending, or shipping a quiet regression.</em>
      </h1>
      <p class="lede">
        Ten projects, each with an architecture document, decision records, tests, and an offline demo on synthetic data. Every number on this site is copied from a committed evaluation.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="#projects">See the projects</a>
        <a class="button" href={site.repo}>Read the code</a>
      </div>
      <dl class="stats">
        {
          stats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="section-head">
        <h2 id="projects-title">Projects</h2>
        <p>Open one for its architecture, the decisions behind it, and what was measured.</p>
      </div>
      <ul class="grid">
        {shipped.map((project, i) => <ProjectCard project={project} featured={i < 4} />)}
      </ul>
    </section>

    <section class="section" id="platform" aria-labelledby="platform-title">
      <div class="section-head">
        <h2 id="platform-title">How they fit together</h2>
        <p>
          Aegis is the trust boundary. Switchboard picks a model after that decision. Lumen answers from documents, Atlas runs multi-step work, and Forge is where untrusted code would run. Lens, Charter, and Arena watch, govern, and compare. Conduit feeds the index and Skyline is where it would all land. Dashed boxes are contracts that are specified and not yet wired.
        </p>
      </div>
      <Diagram diagram={platform} />
    </section>
  </main>

  <footer class="footer">
    <p>{site.name} · <a href={githubProfile}>github.com/kumarlakshya24</a></p>
    <p>Names, emails, card numbers, keys, and documents in the projects are synthetic.</p>
  </footer>
</Base>
