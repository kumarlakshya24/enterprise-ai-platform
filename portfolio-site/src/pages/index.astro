---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PlatformMap from "../components/PlatformMap.astro";
import RequestTrace from "../components/RequestTrace.astro";
import { githubProfile, linkedin, shipped, site } from "../data/projects";

const title = `${site.name} · ${site.role}`;
const description =
  "Ten offline systems for using language models safely, cheaply, and with numbers you can check. Portfolio of Lakshya Kumar.";
const stats = [
  { value: String(shipped.length), label: "projects, each runs alone" },
  { value: String(site.tests), label: "automated tests" },
  { value: "0", label: "API keys needed" },
];
---

<Base title={title} description={description}>
  <SiteHeader />

  <main id="content">
    <section class="hero hero-split" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="pulse" aria-hidden="true"></span>{site.role}</p>
        <h1 id="hero-title">
          I build the systems that let a company use language models <em>without leaking data, overspending, or shipping a quiet regression.</em>
        </h1>
        <p class="lede">
          Ten projects that fit together as one platform. Each has an architecture document, decision records, tests, and an offline demo. Every number on this site comes from a committed evaluation.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#projects">See the projects</a>
          <a class="button" href={site.repo}>Read the code</a>
        </div>
        <dl class="stats">
          {
            stats.map((stat) => (
              <div>
                <dt>{stat.label}</dt>
                <dd>{stat.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <PlatformMap />
    </section>

    <RequestTrace />

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="section-head">
        <h2 id="projects-title">Projects</h2>
        <p>Open one for its architecture, the decisions behind it, and what was measured.</p>
      </div>
      <ul class="grid">
        {shipped.map((project, i) => <ProjectCard project={project} featured={i < 4} />)}
      </ul>
    </section>

    <section class="section about" id="about" aria-labelledby="about-title">
      <div class="section-head">
        <h2 id="about-title">About</h2>
      </div>
      <div class="about-body">
        <p>
          I'm an AI Solutions Architect at AWS with more than five years of experience. I work with digital native enterprises and startups as they build with AI. The ten projects here are the parts I think every company needs before it trusts language models with real work: a security boundary, routing, retrieval with access control, evaluation, and governance.
        </p>
        <ul class="about-links">
          <li><a href="mailto:kumar.lakshya24@gmail.com">kumar.lakshya24@gmail.com</a></li>
          <li><a href={linkedin}>LinkedIn</a></li>
          <li><a href={githubProfile}>GitHub</a></li>
        </ul>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p>{site.name} · <a href={githubProfile}>github.com/kumarlakshya24</a></p>
    <p>Names, emails, card numbers, keys, and documents in the projects are synthetic.</p>
  </footer>
</Base>
