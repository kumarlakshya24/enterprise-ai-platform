---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" data-theme="dark" data-accent="violet">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      // Runs before paint so the saved theme and accent never flash.
      (function () {
        var root = document.documentElement;
        try {
          var theme = localStorage.getItem("theme");
          if (theme === "light" || theme === "dark") root.dataset.theme = theme;
          var accent = localStorage.getItem("accent");
          if (accent) root.dataset.accent = accent;
        } catch (error) {
          /* storage can be blocked; the dark default stands */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <slot />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        function save(key, value) {
          try {
            localStorage.setItem(key, value);
          } catch (error) {
            /* ignore blocked storage */
          }
        }
        var toggle = document.getElementById("theme-toggle");
        function showTheme() {
          if (toggle) toggle.setAttribute("aria-pressed", root.dataset.theme === "light" ? "true" : "false");
        }
        if (toggle) {
          toggle.addEventListener("click", function () {
            root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";
            save("theme", root.dataset.theme);
            showTheme();
          });
        }
        var swatches = document.querySelectorAll("[data-set-accent]");
        function showAccent() {
          swatches.forEach(function (swatch) {
            swatch.setAttribute("aria-checked", swatch.dataset.setAccent === root.dataset.accent ? "true" : "false");
          });
        }
        swatches.forEach(function (swatch) {
          swatch.addEventListener("click", function () {
            root.dataset.accent = swatch.dataset.setAccent;
            save("accent", root.dataset.accent);
            showAccent();
          });
        });
        showTheme();
        showAccent();
      })();
    </script>
  </body>
</html>
