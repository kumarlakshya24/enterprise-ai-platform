---
/**
 * The hero map: the ten projects laid out in the same tiers as the platform
 * diagram, joined by bus lines that never cross. Each node is a link to its
 * project page, so the map works with no JavaScript. With JavaScript, a tap
 * selects the node and fills the panel beside it instead.
 */
import { projects, projectColor } from "../data/projects";

const base = import.meta.env.BASE_URL;
const bySlug = Object.fromEntries(projects.map((p) => [p.slug, p]));

type MapNode = { slug: string; x: number; y: number; dashed?: boolean };

// viewBox is 640 x 700. Tiers top to bottom, x positions are symmetric.
const tiers: { y: number; label: string; nodes: MapNode[] }[] = [
  { y: 130, label: "Trust boundary", nodes: [{ slug: "aegis", x: 320, y: 130 }] },
  {
    y: 250,
    label: "After the security decision",
    nodes: [
      { slug: "switchboard", x: 200, y: 250, dashed: true },
      { slug: "model", x: 440, y: 250 },
    ],
  },
  {
    y: 370,
    label: "What runs",
    nodes: [
      { slug: "lumen", x: 110, y: 370 },
      { slug: "atlas", x: 320, y: 370 },
      { slug: "forge", x: 530, y: 370, dashed: true },
    ],
  },
  {
    y: 490,
    label: "Beside the request",
    nodes: [
      { slug: "lens", x: 110, y: 490 },
      { slug: "charter", x: 320, y: 490 },
      { slug: "arena", x: 530, y: 490 },
    ],
  },
  {
    y: 610,
    label: "Underneath",
    nodes: [
      { slug: "conduit", x: 200, y: 610 },
      { slug: "skyline", x: 440, y: 610 },
    ],
  },
];

const R = 30;
const busOffset = 58;
const spineTop = 52;
const lastBus = tiers[tiers.length - 1].y - busOffset;

const panels = projects
  .filter((p) => p.status === "main")
  .map((p) => ({
    slug: p.slug,
    name: p.name,
    role: p.role,
    summary: p.summary,
    fact: p.facts?.[0],
    color: projectColor[p.slug],
  }));
const first = panels.find((p) => p.slug === "aegis") ?? panels[0];
---

<figure class="map" id="platform" aria-labelledby="map-title">
  <figcaption class="map-head">
    <h2 id="map-title">How the ten fit together</h2>
    <p>Tap a system. Dashed lines are documented contracts that are not wired yet.</p>
  </figcaption>

  <div class="map-body">
    <svg class="map-svg" viewBox="0 0 640 700" role="group" aria-label="Platform map of the ten projects">
      <g class="wires" aria-hidden="true">
        <line class="wire spine" x1="320" y1={spineTop} x2="320" y2={lastBus} />
        {
          tiers.slice(1).map((tier) => {
            const xs = tier.nodes.map((n) => n.x);
            const busY = tier.y - busOffset;
            return (
              <g>
                {xs.length > 1 && <line class="wire" x1={Math.min(...xs)} y1={busY} x2={Math.max(...xs)} y2={busY} />}
                {tier.nodes.map((n) => (
                  <line class:list={["wire", { dashed: n.dashed }]} x1={n.x} y1={busY} x2={n.x} y2={n.y - R} />
                ))}
              </g>
            );
          })
        }
        <circle class="packet" r="5" cx="320" cy={spineTop} />
      </g>

      <g class="users" aria-hidden="true">
        <rect x="250" y="16" width="140" height="36" rx="18" />
        <text x="320" y="39">People and agents</text>
      </g>

      {
        tiers.flatMap((tier) =>
          tier.nodes.map((n) => {
            if (n.slug === "model") {
              return (
                <g class="node model" transform={`translate(${n.x} ${n.y})`} aria-hidden="true">
                  <circle r={R} />
                  <text class="node-name" y={R + 28}>Model</text>
                  <text class="node-sub" y="5">LLM</text>
                </g>
              );
            }
            const p = bySlug[n.slug];
            return (
              <a
                class:list={["node", { dashed: n.dashed }]}
                href={`${base}projects/${n.slug}/`}
                data-node={n.slug}
                aria-label={`${p.name}: ${p.role}`}
                style={`color: ${projectColor[n.slug]}`}
              >
                <g transform={`translate(${n.x} ${n.y})`}>
                  <circle class="halo" r={R + 16} />
                  <circle class="ring" r={R} />
                  <text class="node-index" y="6">{p.index}</text>
                  <text class="node-name" y={R + 28}>{p.name}</text>
                </g>
              </a>
            );
          }),
        )
      }
    </svg>

    <div class="map-panel" aria-live="polite">
      {
        panels.map((p) => (
          <article class="panel" data-panel={p.slug} hidden={p.slug !== first.slug} style={`--p: ${p.color}`}>
            <p class="panel-role">
              <span class="dot" aria-hidden="true" />
              {p.role}
            </p>
            <h3>{p.name}</h3>
            <p class="panel-summary">{p.summary}</p>
            {p.fact && (
              <p class="panel-fact">
                <span class="mono">{p.fact.value}</span>
              </p>
            )}
            <a class="panel-link" href={`${base}projects/${p.slug}/`}>
              Open {p.name} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</figure>

<script is:inline>
  (function () {
    var map = document.querySelector(".map");
    if (!map) return;
    var nodes = map.querySelectorAll("[data-node]");
    var panels = map.querySelectorAll("[data-panel]");
    function select(slug) {
      nodes.forEach(function (n) {
        n.classList.toggle("is-on", n.getAttribute("data-node") === slug);
        n.setAttribute("aria-current", n.getAttribute("data-node") === slug ? "true" : "false");
      });
      panels.forEach(function (p) {
        p.hidden = p.getAttribute("data-panel") !== slug;
      });
    }
    nodes.forEach(function (n) {
      n.addEventListener("click", function (event) {
        var slug = n.getAttribute("data-node");
        // A second tap on the selected node opens its page.
        if (n.classList.contains("is-on")) return;
        event.preventDefault();
        select(slug);
      });
    });
    map.classList.add("is-live");
    select("aegis");
  })();
</script>
